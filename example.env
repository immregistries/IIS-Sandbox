SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/iis
FHIR_VERSION=R4

# Only activate if using H2 databases
SPRING_PROFILES_ACTIVE=h2

# i\In memory example, otherwise point to a PostGresQL Database
SPRING_DATASOURCE_URL=jdbc:h2:mem:fhir-r4-db
ENV_IIS_POSTGRES_DB=hapi_fhir_iis
ENV_IIS_POSTGRES_USER=hapi_iis_web
ENV_IIS_POSTGRES_PASSWORD=change-me

# In memory example, otherwise point to a MySQL Database
IIS_MYSQL_URL=jdbc:h2:mem:iis-sandbox-db
ENV_IIS_MYSQL_USER=iis_web
ENV_IIS_MYSQL_PASSWORD=change-me
ENV_IIS_MYSQL_ROOT_PASSWORD=change-me

ENV_IIS_JWT_SECRET=
ENV_IIS_GITHUB_CLIENT_ID=optional
ENV_IIS_GITHUB_CLIENT_SECRET=optional
# User management
# Create the admin account at startup if it is missing. Both IIS_ADMIN_USER and
# IIS_ADMIN_PASSWORD must be set to real values, otherwise nothing is created.
IIS_CREATE_ADMIN_IF_NOT_EXISTS=false
IIS_ADMIN_USER=admin
IIS_ADMIN_PASSWORD=change-me
# Set to false to reject logins for unknown usernames instead of creating the account.
IIS_ALLOW_SELF_REGISTRATION=true
