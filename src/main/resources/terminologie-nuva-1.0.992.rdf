  <rdf:Description rdf:about="#VAC0943">
    <rdfs:label xml:lang="en">Rabies vaccine diploid cells, unspecified</rdfs:label>
    <rdfs:label xml:lang="fr">Vaccin Rage cellules diploïdes, sans précision</rdfs:label>
    <rdfs:label xml:lang="de">Diploide Zellen des Tollwutimpfstoffs, nicht näher bezeichnet</rdfs:label>
    <rdfs:label xml:lang="pt">Células diplóides da vacina contra a raiva, não especificadas</rdfs:label>
    <rdfs:label xml:lang="pl">RabKomórki diploidalne szczepionki przeciw wściekliźnie, nieokreślone</rdfs:label>
    <rdfs:label xml:lang="gr">Διπλοειδή κύτταρα αντιλυσσικού εμβολίου, απροσδιόριστα</rdfs:label>
    <rdfs:label xml:lang="lv">Trakumsērgas vakcīnas diploīdās šūnas, neprecizētas</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
