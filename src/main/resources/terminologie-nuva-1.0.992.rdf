    <rdfs:comment xml:lang="en">COVID-19 vaccine, mRNA encoding the SARS-CoV-2 spike protein, original virus</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-21</dct:modified>
