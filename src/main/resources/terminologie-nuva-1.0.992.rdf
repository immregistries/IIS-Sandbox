    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-19</dct:created>
    <rdfs:comment xml:lang="en">Inactivated polio (trivalent) vaccine</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin poliomyélitique (entier inactivé, trivalent)</rdfs:comment>
    <rdfs:comment xml:lang="de">Inaktivierter Polio-Impfstoff (dreiwertig)</rdfs:comment>
    <rdfs:comment xml:lang="lv">Inaktivēta poliomielīta (trivalenta) vakcīna</rdfs:comment>
    <rdfs:comment xml:lang="gr">Αδρανοποιημένο εμβόλιο πολιομυελίτιδας (τρισθενές)</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina inactivada contra a poliomielite (trivalente)</rdfs:comment>
    <rdfs:comment xml:lang="pl">Inaktywowana szczepionka przeciw polio (trójwalentna)</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-08-15</dct:modified>
