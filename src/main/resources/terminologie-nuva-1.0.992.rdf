    <rdfs:comment xml:lang="fr">Vaccin contre la grippe saisonnière trivalent inactivé, à antigène de surface</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-04</dct:modified>
    <skos:notation>VAC1282</skos:notation>
