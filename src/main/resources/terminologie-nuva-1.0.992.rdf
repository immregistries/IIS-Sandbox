  <rdf:Description rdf:about="#VAC0873">
    <rdfs:label>INFLUPOZZI ADIUVATO</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-03-26</dct:created>
    <rdfs:comment xml:lang="fr">Vaccin contre la grippe saisonnière inactivé trivalent, cultivé sur oeuf, à antigène de surface, avec adjuvant MF59C.1</rdfs:comment>
    <rdfs:comment xml:lang="en">Trivalent inactivated seasonal influenza vaccine, egg-based, surface antigen, adjuvanted with MF59C.1</rdfs:comment>
    <rdfs:comment xml:lang="de">Trivalenter inaktivierter saisonaler Grippeimpfstoff auf Eibasis, Oberflächenantigen, adjuvantiert mit MF59C.1</rdfs:comment>
    <rdfs:comment xml:lang="pl">Trójwartościowa inaktywowana szczepionka przeciwko grypie sezonowej, oparta na jajach, z antygenem powierzchniowym, adiuwantowana MF59C.1</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina trivalente inactivada contra a gripe sazonal, à base de ovos, antigénio de superfície, adjuvante do MF59C.1</rdfs:comment>
    <rdfs:comment xml:lang="lv">Trivalenta inaktivēta sezonālās gripas vakcīna uz olu bāzes, ar virsmas antigēnu, adjuvansēta ar MF59C.1.</rdfs:comment>
    <rdfs:comment xml:lang="gr">Τρισθενές αδρανοποιημένο εμβόλιο εποχικής γρίπης, με βάση το αυγό, επιφανειακό αντιγόνο, ενισχυμένο με MF59C.1</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-23</dct:modified>
    <skos:notation>VAC0873</skos:notation>
    <nuvs:containsValence rdf:resource="#VAL015"/>
    <nuvs:isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</nuvs:isAbstract>
