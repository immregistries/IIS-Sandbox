    <rdfs:comment xml:lang="pl">Szczepionka COVID-19, cały wirus inaktywowany, adiuwant (adiuwant: wodorotlenek glinu)</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina COVID-19, virião inteiro inactivado, adjuvante (adjuvante: hidróxido de alumínio)</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-08</dct:modified>
