    <rdfs:label xml:lang="gr">Εμβόλιο λύσσας εμβρύου κοτόπουλου, απροσδιόριστο</rdfs:label>
    <rdfs:label xml:lang="lv">Vistas embrija trakumsērgas vakcīna, neprecizēta</rdfs:label>
