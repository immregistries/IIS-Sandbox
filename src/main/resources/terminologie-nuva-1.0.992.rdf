  <rdf:Description rdf:about="#VAC0707">
    <rdfs:label>CORONAVIRUS SARS-CoV-2 INACTIVÉ</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
