    <skos:hiddenLabel>dtca</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#VAC0912">
    <rdfs:label xml:lang="en">Hepatitis A vaccine, pediatric dose, unspecified</rdfs:label>
    <rdfs:label xml:lang="fr">Vaccin Hépatite A, dose pédiatrique, sans précision</rdfs:label>
    <rdfs:label xml:lang="de">Hepatitis-A-Impfstoff, pädiatrische Dosis, nicht spezifiziert</rdfs:label>
    <rdfs:label xml:lang="pl">Szczepionka przeciwko wirusowemu zapaleniu wątroby typu A, dawka pediatryczna, nieokreślona</rdfs:label>
    <rdfs:label xml:lang="lv">Vakcīna pret A hepatītu, pediatriskā deva, neprecizēta</rdfs:label>
    <rdfs:label xml:lang="gr">Εμβόλιο ηπατίτιδας Α, παιδιατρική δόση, απροσδιόριστη</rdfs:label>
    <rdfs:label xml:lang="pt">Vacina contra hepatite A, dose pediátrica, não especificada</rdfs:label>
