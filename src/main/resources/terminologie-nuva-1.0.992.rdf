    <rdfs:comment xml:lang="pt">Vacina contra a varíola do frango</rdfs:comment>
    <rdfs:comment xml:lang="lv">Vējbakas vakcīna</rdfs:comment>
    <rdfs:comment xml:lang="pl">Szczepionka przeciwko ospie wietrznej</rdfs:comment>
