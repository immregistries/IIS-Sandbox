  </rdf:Description>
  <rdf:Description rdf:about="#VAC0897">
    <rdfs:label xml:lang="en">Hantavirus vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="fr">Vaccin Hantavirus, sans précision</rdfs:label>
