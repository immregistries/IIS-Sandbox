    <rdfs:comment xml:lang="pl">Rekombinowana szczepionka przeciwko wirusowemu zapaleniu wątroby typu B</rdfs:comment>
    <rdfs:comment xml:lang="lv">rekombinantā B hepatīta vakcīna</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina contra a hepatite B recombinante</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-10-28</dct:modified>
