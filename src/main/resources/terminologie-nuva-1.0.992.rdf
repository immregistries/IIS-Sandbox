  <rdf:Description rdf:about="#VAC0946">
    <rdfs:label>TYPHIDRALL</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-25</dct:created>
    <rdfs:comment xml:lang="fr">Vaccin typhoïdique et paratyphoïdique A et B, entier inactivé</rdfs:comment>
    <rdfs:comment xml:lang="en">Typhoid and paratyphoid A and B vaccine, whole-cell inactivated</rdfs:comment>
    <rdfs:comment xml:lang="de">Impfstoff gegen Typhus und Paratyphus A und B, inaktivierter Ganzzellimpfstoff</rdfs:comment>
    <rdfs:comment xml:lang="pl">Szczepionka przeciwko durowi brzusznemu i paratyfusowi typu A i B, inaktywowana, całokomórkowa</rdfs:comment>
    <rdfs:comment xml:lang="lv">A un B vēdertīfa un paratifa vakcīna, inaktivēta, veselas šūnas</rdfs:comment>
