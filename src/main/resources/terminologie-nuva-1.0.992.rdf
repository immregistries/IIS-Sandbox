    <skos:hiddenLabel>dengvagsia</skos:hiddenLabel>
    <skos:hiddenLabel>DENGXAVIA</skos:hiddenLabel>
    <skos:hiddenLabel>denguevaxia</skos:hiddenLabel>
  </rdf:Description>
