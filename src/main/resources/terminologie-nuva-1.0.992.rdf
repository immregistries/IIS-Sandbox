    <skos:hiddenLabel>DTadsorbé</skos:hiddenLabel>
    <skos:hiddenLabel>D.T.</skos:hiddenLabel>
    <skos:hiddenLabel>Vaccin Diphtérique et Tétanique adsorbé</skos:hiddenLabel>
    <skos:hiddenLabel>vaccindt</skos:hiddenLabel>
    <skos:hiddenLabel>vaccin DT</skos:hiddenLabel>
  </rdf:Description>
