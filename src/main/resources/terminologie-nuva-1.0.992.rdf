    <skos:hiddenLabel>typhoidique</skos:hiddenLabel>
    <skos:hiddenLabel>Thyphim</skos:hiddenLabel>
    <skos:hiddenLabel>typhimvi</skos:hiddenLabel>
    <skos:hiddenLabel>TYPHIM VI</skos:hiddenLabel>
    <skos:hiddenLabel>TYPHIM</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#VAC0174">
    <rdfs:label>PROQUAD</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-19</dct:created>
    <rdfs:comment xml:lang="en">Live attenuated measles, mumps, rubella and chickenpox vaccine</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin vivant atténué contre la rougeole, la rubéole, les oreillons et la varicelle</rdfs:comment>
    <rdfs:comment xml:lang="de">Attenuierter Lebendimpfstoff gegen Masern, Mumps, Röteln und Windpocken</rdfs:comment>
