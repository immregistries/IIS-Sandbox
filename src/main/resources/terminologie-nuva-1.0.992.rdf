  <rdf:Description rdf:about="#VAC0612">
    <rdfs:label>DTP-vax FINLAY</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-19</dct:created>
    <rdfs:comment xml:lang="fr">Vaccin pédiatrique diphtérique (anatoxine, dose standard), tétanique (anatoxine) et coquelucheux (entier inactivé)</rdfs:comment>
    <rdfs:comment xml:lang="en">Diphtheria toxoid (standard dose), tetanus toxoid and whole-cell inactivated pertussis pediatric vaccine</rdfs:comment>
    <rdfs:comment xml:lang="de">Diphtherie-Toxoid (Standarddosis), Tetanus-Toxoid und inaktivierter Keuchhusten-Vollzellimpfstoff für Kinder</rdfs:comment>
    <rdfs:comment xml:lang="gr">Παιδιατρικό εμβόλιο διφθεριτικού τοξοειδούς (τυπική δόση), τετανικού τοξοειδούς και αδρανοποιημένου κοκκύτη ολικού κυττάρου</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina pediátrica contra difteria toxoide (dose padrão), tétano toxoide e tosse convulsa inativada de células inteiras</rdfs:comment>
    <rdfs:comment xml:lang="lv">Difterijas toksoīda (standarta deva), stingumkrampju toksoīda un veselas šūnas inaktivētas garo klepusakcīnas pediatriskā vakcīna</rdfs:comment>
    <rdfs:comment xml:lang="pl">Toksoid błoniczy (dawka standardowa), toksoid tężcowy i całokomórkowa inaktywowana szczepionka przeciw krztuścowi dla dzieci</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-10-28</dct:modified>
    <skos:notation>VAC0612</skos:notation>
    <nuvs:containsValence rdf:resource="#VAL097"/>
    <nuvs:containsValence rdf:resource="#VAL067"/>
    <nuvs:containsValence rdf:resource="#VAL010"/>
    <nuvs:isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</nuvs:isAbstract>
    <skos:hiddenLabel>DTwP(coquelucheuxentierdosecomplète)</skos:hiddenLabel>
    <skos:hiddenLabel>D/T/wP</skos:hiddenLabel>
    <skos:hiddenLabel>D.T.wP</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#VAL285">
    <rdfs:label xml:lang="gr">Τρισθενής αδρανοποιημένη βαλεντία της γρίπης που προέρχεται από κυτταροκαλλιέργεια, κλασματοποιημένη ή υπομονάδα, κανονική δόση</rdfs:label>
    <rdfs:label xml:lang="de">Trivalente inaktivierte Influenza-Valenz aus Zellkultur, spalt- oder untereinheitlich, normale Dosis</rdfs:label>
    <rdfs:label xml:lang="pt">alência vacinal trivalente inativada da gripe obtida por cultura celular, fracionada ou de subunidade, dose normal</rdfs:label>
    <rdfs:label xml:lang="lv">Trivalenta inaktivēta gripas valence, iegūta no šūnu kultūras, frakcionēta vai apakšvienība, normāla deva</rdfs:label>
    <rdfs:label xml:lang="pl">Trójwalentna inaktywowana wartość przeciwko grypie uzyskana z hodowli komórkowej, dzielona lub podjednostkowa, normalna dawka</rdfs:label>
    <rdfs:label xml:lang="en">Influenza valence, trivalent, inactivated, obtained from cell culture, split or subunit, standard dose</rdfs:label>
    <rdfs:label xml:lang="fr">Valence grippe, trivalente, inactivée, obtenue sur culture cellulaire, fractionnée ou sous-unité, dose normale</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Valence"/>
    <rdfs:subClassOf rdf:resource="#VAL360"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-06</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-29</dct:modified>
    <skos:notation>VAL285</skos:notation>
    <skos:altLabel xml:lang="fr">Inf-CC3</skos:altLabel>
    <skos:altLabel xml:lang="en">INF-CC3</skos:altLabel>
    <nuvs:containedInVaccine rdf:resource="#VAC0926"/>
    <nuvs:containedInVaccine rdf:resource="#VAC1175"/>
    <nuvs:containedInVaccine rdf:resource="#VAC1359"/>
    <nuvs:prevents rdf:resource="#D15"/>
  </rdf:Description>
  <rdf:Description rdf:about="#VAC0963">
    <rdfs:label>ANATOXAL DI TE PER</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-30</dct:created>
    <rdfs:comment xml:lang="fr">Vaccin pédiatrique diphtérique (anatoxine, dose standard), tétanique (anatoxine) et coquelucheux (entier inactivé)</rdfs:comment>
    <rdfs:comment xml:lang="de">Diphtherieimpfstoff (Toxoid, Standarddosis), Tetanusimpfstoff (Toxoid) und Keuchhustenimpfstoff (inaktivierter Ganzzellimpfstoff) für Kinder</rdfs:comment>
    <rdfs:comment xml:lang="pl">Szczepionka pediatryczna przeciwko błonicy (toksoid, dawka standardowa), tężcowi (toksoid) i krztuścowi (inaktywowana całokomórkowo)</rdfs:comment>
    <rdfs:comment xml:lang="gr">Παιδιατρικό εμβόλιο διφθερίτιδας (τοξοειδές, τυπική δόση), τετάνου (τοξοειδές) και κοκκύτη (αδρανοποιημένο σε ολόκληρο το κύτταρο)</rdfs:comment>
    <rdfs:comment xml:lang="lv">Difterijas (toksoīds, standarta deva), stingumkrampju (toksoīds) un stingumkrampju (pilnšūnu inaktivētā) pediatriskā vakcīna</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina pediátrica contra difteria (toxoide, dose padrão), tétano (toxoide) e coqueluche (inactivada por células inteiras)</rdfs:comment>
    <rdfs:comment xml:lang="en">Diphtheria toxoid (standard dose), tetanus toxoid and pertussis (whole-cell inactivated) pediatric vaccine</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-16</dct:modified>
    <skos:notation>VAC0963</skos:notation>
    <nuvs:containsValence rdf:resource="#VAL097"/>
