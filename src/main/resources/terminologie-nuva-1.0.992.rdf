  <rdf:Description rdf:about="#VAL359">
    <rdfs:label xml:lang="de">Inaktivierte Ganzzell-Cholera-Valenz, ohne Spezifikation</rdfs:label>
    <rdfs:label xml:lang="gr">Αδρανοποιημένη ολόκληρη χολερική βαλεντία, χωρίς διευκρίνιση</rdfs:label>
    <rdfs:label xml:lang="pt">Valência colérica inteira inativada, sem especificação</rdfs:label>
    <rdfs:label xml:lang="lv">Inaktivēta visa holēras valence, bez precizējuma</rdfs:label>
    <rdfs:label xml:lang="pl">Wartość całkowicie inaktywowana przeciwko cholerze, bez określenia</rdfs:label>
    <rdfs:label xml:lang="fr">Valence choléra, inactivée, entière, sans précision</rdfs:label>
    <rdfs:label xml:lang="en">Cholera valence, inactivated, whole-cell, unspecified</rdfs:label>
