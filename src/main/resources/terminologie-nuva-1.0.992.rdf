    <rdfs:comment xml:lang="fr">Vaccin recombinant peptidique contre l'hépatite E</rdfs:comment>
    <rdfs:comment xml:lang="en">Recombinant Hepatitis E Peptide vaccine</rdfs:comment>
    <rdfs:comment xml:lang="de">Rekombinanter Hepatitis-E-Peptid-Impfstoff</rdfs:comment>
    <rdfs:comment xml:lang="lv">Rekombinantā E hepatīta peptīda vakcīna</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina contra a Hepatite Recombinante E Peptídeo</rdfs:comment>
    <rdfs:comment xml:lang="gr">Εμβόλιο ανασυνδυασμένου πεπτιδίου ηπατίτιδας Ε</rdfs:comment>
    <rdfs:comment xml:lang="pl">Rekombinowana szczepionka peptydowa przeciwko zapaleniu wątroby typu E</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-08</dct:modified>
    <skos:notation>VAC0526</skos:notation>
