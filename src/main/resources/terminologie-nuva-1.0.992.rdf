    <rdfs:comment xml:lang="lv">COVID-19 vakcīna, proteīna apakšvienība</rdfs:comment>
    <rdfs:comment xml:lang="gr">Εμβόλιο COVID-19, πρωτεϊνική υπομονάδα</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina COVID-19, subunidade de proteínas</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-04</dct:modified>
    <skos:notation>VAC0668</skos:notation>
