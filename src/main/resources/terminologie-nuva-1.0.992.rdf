  <rdf:Description rdf:about="#VAC0223">
    <rdfs:label>DUAL ANTIGEN SII</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-19</dct:created>
    <rdfs:comment xml:lang="en">Diphtheria toxoid (standard dose) and tetanus toxoid pediatric vaccine</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin pédiatrique diphtérique (anatoxine, dose standard) et tétanique (anatoxine)</rdfs:comment>
    <rdfs:comment xml:lang="de">Diphtherietoxoid- (Standarddosis) und Tetanustoxoid-Pädiatrieimpfstoff</rdfs:comment>
    <rdfs:comment xml:lang="lv">Difterijas toksoīda (standarta deva) un stingumkrampju toksoīda pediatriskā vakcīna</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina pediátrica contra difteria toxoídica (dose padrão) e tétano toxoídico</rdfs:comment>
    <rdfs:comment xml:lang="pl">Szczepionka pediatryczna zawierająca toksoid błoniczy (dawka standardowa) i toksoid tężcowy</rdfs:comment>
    <rdfs:comment xml:lang="gr">Παιδιατρικό εμβόλιο διφθεριτικού τοξοειδούς (τυπική δόση) και τετανικού τοξοειδούς</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-14</dct:modified>
    <skos:notation>VAC0223</skos:notation>
    <nuvs:containsValence rdf:resource="#VAL097"/>
    <nuvs:containsValence rdf:resource="#VAL067"/>
    <nuvs:isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</nuvs:isAbstract>
    <skos:hiddenLabel>DUALANTIGENSII</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#VAC0356">
    <rdfs:label>RECOMBIVAX HB PÉDIATRIQUE</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-19</dct:created>
    <rdfs:comment xml:lang="en">Hepatitis B vaccine (Paediatric and adult dosage at 10 µg and dosage for dialysis patients at 40 µg)</rdfs:comment>
    <rdfs:comment xml:lang="de">Hepatitis-B-Impfstoff (für Kinder und Erwachsene in einer Dosierung von 10 µg und für Dialysepatienten in einer Dosierung von 40 µg)</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin contre l'hépatite B , dosage pédiatrique à 10 µg</rdfs:comment>
    <rdfs:comment xml:lang="pl">Szczepionka przeciwko wirusowemu zapaleniu wątroby typu B (dawka dla dzieci i dorosłych 10 µg, a dawka dla pacjentów dializowanych 40 µg)</rdfs:comment>
    <rdfs:comment xml:lang="gr">Εμβόλιο ηπατίτιδας Β (παιδιατρική και ενήλικη δοσολογία στα 10 μg και δοσολογία για ασθενείς με αιμοκάθαρση στα 40 μg)</rdfs:comment>
    <rdfs:comment xml:lang="lv">B hepatīta vakcīna (bērnu un pieaugušo vakcīnas deva 10 µg un dializējamiem pacientiem - 40 µg)</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina contra a hepatite B (dosagem pediátrica e para adultos a 10 µg e dosagem para doentes em diálise a 40 µg)</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-10-28</dct:modified>
    <skos:notation>VAC0356</skos:notation>
    <nuvs:containsValence rdf:resource="#VAL068"/>
    <nuvs:isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</nuvs:isAbstract>
    <skos:hiddenLabel>RECOMBIVAXHB</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#VAC0005">
    <rdfs:label>DUKORAL</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-19</dct:created>
    <rdfs:comment xml:lang="en">Oral cholera vaccine containing recombinant cholera toxin subunit B (rTCB) and inactivated bacteria with an adjuvant role</rdfs:comment>
    <rdfs:comment xml:lang="de">Schluckimpfstoff gegen Cholera, der rekombinantes Choleratoxin Untereinheit B (rTCB) und inaktivierte Bakterien mit einer Adjuvansfunktion enthält</rdfs:comment>
    <rdfs:comment xml:lang="gr">Εμβόλιο χολέρας από το στόμα που περιέχει ανασυνδυασμένη υπομονάδα Β της τοξίνης της χολέρας (rTCB) και αδρανοποιημένα βακτήρια με επικουρικό ρόλο</rdfs:comment>
    <rdfs:comment xml:lang="pl">Doustna szczepionka przeciwko cholerze zawierająca rekombinowaną podjednostkę B toksyny cholery (rTCB) oraz inaktywowane bakterie z rolą adiuwanta</rdfs:comment>
    <rdfs:comment xml:lang="lv">Perorālā holēras vakcīna, kas satur rekombinantu holēras toksīna B apakšvienību (rTCB) un inaktivētas baktērijas ar palīgvielas nozīmi</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina oral contra a cólera contendo toxina recombinante da cólera subunidade B (rTCB) e bactérias inactivadas com um papel adjuvante</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin cholérique, par voie orale, contenant la sous-unité B de la toxine cholérique recombinante (rTCB) et des bactéries inactivées ayant un rôle adjuvant</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-06-03</dct:modified>
    <skos:notation>VAC0005</skos:notation>
    <nuvs:containsValence rdf:resource="#VAL062"/>
    <nuvs:isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</nuvs:isAbstract>
    <skos:hiddenLabel>cholera</skos:hiddenLabel>
    <skos:hiddenLabel>cholerique</skos:hiddenLabel>
    <skos:hiddenLabel>duchoral</skos:hiddenLabel>
    <skos:hiddenLabel>DUKORAL</skos:hiddenLabel>
    <skos:hiddenLabel>ducoral</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#VAC0138">
    <rdfs:label xml:lang="en">Diphtheria-Tetanus-Pertussis-Polio vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="de">Diphtheria-Tetanus-Pertussis-Polio vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="pt">Diphtheria-Tetanus-Pertussis-Polio vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="pl">Diphtheria-Tetanus-Pertussis-Polio vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="lv">Diphtheria-Tetanus-Pertussis-Polio vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="fr">Vaccin DiphTPCoq - Diphtérie-Tétanos-Coqueluche-Polio, sans précision</rdfs:label>
    <rdfs:label xml:lang="gr">Diphtheria-Tetanus-Pertussis-Polio vaccine, unspecified</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-19</dct:created>
    <rdfs:comment xml:lang="de">Diphtherietoxoid (Dosis nicht spezifiziert), Tetanustoxoid, azellulärer oder ganzzelliger inaktivierter Pertussis-Impfstoff (Dosis nicht spezifiziert) und inaktivierter Polio-Impfstoff (trivalent)</rdfs:comment>
    <rdfs:comment xml:lang="gr">Τοξοειδές διφθερίτιδας (δόση που δεν προσδιορίζεται), τοξοειδές τετάνου, αδρανοποιημένος κοκκύτης (δόση που δεν προσδιορίζεται) και αδρανοποιημένο εμβόλιο πολιομυελίτιδας (τρισθενές)</rdfs:comment>
    <rdfs:comment xml:lang="lv">Difterijas toksoīda (deva nav norādīta), stingumkrampju toksoīda, acelulārās vai pilnšūnu inaktivētās garo klepusas (deva nav norādīta) un inaktivētās poliomielīta (trivalentās) vakcīnas</rdfs:comment>
    <rdfs:comment xml:lang="pl">Toksoid błoniczy (dawka nieokreślona), toksoid tężcowy, acelularna lub całokomórkowa inaktywowana szczepionka przeciw krztuścowi (dawka nieokreślona) oraz inaktywowana szczepionka przeciw polio (trójwalentna)</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina contra a difteria toxoide (dose não especificada), tétano toxoide, tosse convulsa acelular ou de célula inteira inactivada (dose não especificada) e vacina contra a poliomielite inactivada (trivalente)</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin diphtérique (anatoxine, dose non précisée), tétanique (anatoxine), coquelucheux (acellulaire ou entier inactivé, dose non précisée) et poliomyélitique (entier inactivé, trivalent)</rdfs:comment>
    <rdfs:comment xml:lang="en">Diphtheria toxoid (unspecified dose), tetanus toxoid, pertussis (whole-cell inactivated or acellular, unspecified dose) and inactivated polio (trivalent) vaccine</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-05-19</dct:modified>
    <skos:notation>VAC0138</skos:notation>
    <nuvs:containsValence rdf:resource="#VAL056"/>
    <nuvs:containsValence rdf:resource="#VAL067"/>
    <nuvs:containsValence rdf:resource="#VAL003"/>
    <nuvs:containsValence rdf:resource="#VAL083"/>
    <nuvs:isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</nuvs:isAbstract>
    <skos:hiddenLabel>DTCoqP</skos:hiddenLabel>
    <skos:hiddenLabel>diphTcoqpolio</skos:hiddenLabel>
    <skos:hiddenLabel>dtcp</skos:hiddenLabel>
    <skos:hiddenLabel>D.T.C.P.</skos:hiddenLabel>
    <skos:hiddenLabel>D.T.Coq.P</skos:hiddenLabel>
    <skos:hiddenLabel>vaccindtcoqpolio</skos:hiddenLabel>
    <skos:hiddenLabel>DTAPIPV</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#VAC0489">
    <rdfs:label>TRIMOVAX</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-19</dct:created>
    <rdfs:comment xml:lang="en">Live attenuated measles, mumps and rubella vaccine</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin vivant atténué contre la rougeole, les oreillons et la rubéole</rdfs:comment>
    <rdfs:comment xml:lang="de">Attenuierter Lebendimpfstoff gegen Masern, Mumps und Röteln</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina viva atenuada contra o sarampo, a papeira e a rubéola</rdfs:comment>
    <rdfs:comment xml:lang="gr">Ζωντανό εξασθενημένο εμβόλιο ιλαράς, παρωτίτιδας και ερυθράς</rdfs:comment>
    <rdfs:comment xml:lang="pl">Żywa atenuowana szczepionka przeciwko odrze, śwince i różyczce</rdfs:comment>
    <rdfs:comment xml:lang="lv">dzīvā novājinātā masalu, parotīta un masaliņu vakcīna</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-08-15</dct:modified>
    <skos:notation>VAC0489</skos:notation>
    <nuvs:containsValence rdf:resource="#VAL079"/>
    <nuvs:containsValence rdf:resource="#VAL005"/>
    <nuvs:containsValence rdf:resource="#VAL077"/>
    <nuvs:isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</nuvs:isAbstract>
    <skos:hiddenLabel>Trimovax</skos:hiddenLabel>
    <skos:hiddenLabel>trimovacc</skos:hiddenLabel>
    <skos:hiddenLabel>trimo-vax</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#VAC1421">
    <rdfs:label xml:lang="fr">Vaccin anti-covid 19 à ARNm codant la protéine de pointe du SARS-CoV-2, virus originel</rdfs:label>
    <rdfs:label xml:lang="en">COVID-19 vaccine, mRNA encoding the SARS-CoV-2 spike protein, original virus</rdfs:label>
