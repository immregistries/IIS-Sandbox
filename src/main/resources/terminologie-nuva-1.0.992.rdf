    <skos:hiddenLabel>HPV</skos:hiddenLabel>
    <skos:hiddenLabel>papillomavirus</skos:hiddenLabel>
    <skos:hiddenLabel>CERVARIX</skos:hiddenLabel>
  </rdf:Description>
