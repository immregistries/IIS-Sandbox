  <rdf:Description rdf:about="#VAC0642">
    <rdfs:label>FLUZONE HIGH-DOSE QUADRIVALENT</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
