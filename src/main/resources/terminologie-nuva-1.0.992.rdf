  <rdf:Description rdf:about="#VAC0805">
    <rdfs:label xml:lang="en">Whole-cell inactivated cholera vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="de">Whole-cell inactivated cholera vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="pt">Whole-cell inactivated cholera vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="pl">Whole-cell inactivated cholera vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="lv">Whole-cell inactivated cholera vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="gr">Whole-cell inactivated cholera vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="fr">Vaccin Choléra, entier inactivé, injectable, sans précision</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-10-26</dct:created>
    <rdfs:comment xml:lang="en">Inactivated whole-cell cholera vaccine for injection</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin cholérique entier inactivé, injectable</rdfs:comment>
    <rdfs:comment xml:lang="de">Inaktivierter Cholera-Vollzellimpfstoff zur Injektion</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina inactivada contra a cólera de células inteiras para injecção</rdfs:comment>
    <rdfs:comment xml:lang="pl">Inaktywowana, pełnokomórkowa szczepionka przeciwko cholerze do wstrzykiwań</rdfs:comment>
    <rdfs:comment xml:lang="lv">Inaktivēta pilnšūnu holēras vakcīna injekcijām</rdfs:comment>
    <rdfs:comment xml:lang="gr">Αδρανοποιημένο ολικό εμβόλιο χολέρας για ένεση</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-07-05</dct:modified>
    <skos:notation>VAC0805</skos:notation>
    <nuvs:containsValence rdf:resource="#VAL004"/>
    <nuvs:isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</nuvs:isAbstract>
    <skos:hiddenLabel>Vaccincholériqueentierinactivé</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#VAC0938">
    <rdfs:label xml:lang="fr">Vaccin Grippe quadrivalent, sans précision</rdfs:label>
    <rdfs:label xml:lang="en">Quadrivalent influenza vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="pl">Czterowalentna szczepionka przeciw grypie, nieokreślona</rdfs:label>
    <rdfs:label xml:lang="gr">Τετραδύναμο εμβόλιο γρίπης, απροσδιόριστο</rdfs:label>
    <rdfs:label xml:lang="pt">Vacina quadrivalente contra influenza, não especificada</rdfs:label>
    <rdfs:label xml:lang="lv">Neprecizēta četrvērtīgā gripas vakcīna</rdfs:label>
    <rdfs:label xml:lang="de">Quadrivalenter Grippeimpfstoff, nicht näher bezeichnet</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-17</dct:created>
    <rdfs:comment xml:lang="fr">Vaccin contre la grippe saisonnière inactivé quadrivalent, à virion fractionné ou à antigène de surface</rdfs:comment>
    <rdfs:comment xml:lang="en">Quadrivalent inactivated seasonal influenza vaccine, split virion or surface antigen vaccine</rdfs:comment>
    <rdfs:comment xml:lang="de">Vierwertiger inaktivierter Impfstoff gegen die saisonale Grippe, Spaltvirion oder Oberflächenantigenimpfstoff</rdfs:comment>
    <rdfs:comment xml:lang="pl">Czterowalentna inaktywowana szczepionka przeciwko grypie sezonowej, szczepionka z rozszczepionym wirionem lub antygenem powierzchniowym</rdfs:comment>
    <rdfs:comment xml:lang="gr">Τετραδύναμο αδρανοποιημένο εμβόλιο εποχικής γρίπης, εμβόλιο διαιρεμένου ιού ή επιφανειακού αντιγόνου</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina contra a gripe sazonal quadrivalente inactivada, virião fraccionado ou vacina contra o antigénio de superfície</rdfs:comment>
    <rdfs:comment xml:lang="lv">Četrivalenta inaktivēta sezonālās gripas vakcīna, sadalīta virionu vai virsmas antigēna vakcīna</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-07-05</dct:modified>
    <skos:notation>VAC0938</skos:notation>
    <nuvs:containsValence rdf:resource="#VAL040"/>
    <nuvs:isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</nuvs:isAbstract>
    <skos:hiddenLabel>Vaccin Grippe quadrivalent sans précision</skos:hiddenLabel>
    <skos:hiddenLabel>Quadrivalent influenza vaccine unspecified</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#VAC1121">
    <rdfs:label xml:lang="fr">Vaccin hexavalent DTCaHibPHepB - Diphtérie-Tétanos-Coqueluche-Hib-Polio-Hépatite B 10µg, sans précision</rdfs:label>
    <rdfs:label xml:lang="en">Hexavalent vaccine DTPaHibPHepB - Diphtheria-Tetanus-Pertussis-Hib-Polio-Hepatitis B 10µg, unspecified</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-05</dct:created>
    <rdfs:comment xml:lang="fr">Vaccin pédiatrique diphtérique (anatoxine, dose standard), tétanique (anatoxine), coquelucheux (acellulaire multicomposé, dose standard, 3 composants), anti-Haemophilus influenzae type b (conjugué à l'anatoxine tétanique), poliomyélitique (entier inactivé, trivalent) et de l’hépatite B (recombinant), sans précision</rdfs:comment>
    <rdfs:comment xml:lang="en">Pediatric vaccine diphtheria (toxoid, standard dose), tetanus (toxoid), pertussis (acellular multicomponent, standard dose, 3 components), anti-Haemophilus influenzae type b (conjugated with tetanus toxoid), poliomyelitis (whole inactivated, trivalent) and hepatitis B (recombinant), unspecified</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-08-05</dct:modified>
    <skos:notation>VAC1121</skos:notation>
    <nuvs:containsValence rdf:resource="#VAL097"/>
    <nuvs:containsValence rdf:resource="#VAL056"/>
    <nuvs:containsValence rdf:resource="#VAL067"/>
    <nuvs:containsValence rdf:resource="#VAL008"/>
    <nuvs:containsValence rdf:resource="#VAL114"/>
    <nuvs:containsValence rdf:resource="#VAL156"/>
    <nuvs:isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</nuvs:isAbstract>
  </rdf:Description>
