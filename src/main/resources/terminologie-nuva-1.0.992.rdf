    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-19</dct:created>
    <rdfs:comment xml:lang="en">Live attenuated measles vaccine</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin vivant atténué contre la rougeole</rdfs:comment>
    <rdfs:comment xml:lang="de">Attenuierter Lebendimpfstoff gegen Masern</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina viva atenuada contra o sarampo</rdfs:comment>
    <rdfs:comment xml:lang="gr">Ζωντανό εξασθενημένο εμβόλιο ιλαράς</rdfs:comment>
    <rdfs:comment xml:lang="lv">Dzīva novājināta vakcīna pret masalām</rdfs:comment>
    <rdfs:comment xml:lang="pl">Żywa atenuowana szczepionka przeciwko odrze</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-10-28</dct:modified>
    <skos:notation>VAC0290</skos:notation>
