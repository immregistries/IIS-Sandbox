  <rdf:Description rdf:about="#VAC0925">
    <rdfs:label xml:lang="en">Trivalent inactivated influenza vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="fr">Vaccin Grippe trivalent inactivé, sans précision</rdfs:label>
    <rdfs:label xml:lang="gr">Τριδύναμο αδρανοποιημένο εμβόλιο γρίπης, απροσδιόριστο</rdfs:label>
    <rdfs:label xml:lang="pl">Trójwalentna inaktywowana szczepionka przeciw grypie, nieokreślona</rdfs:label>
    <rdfs:label xml:lang="lv">Trīsvērtīgā inaktivēta gripas vakcīna, neprecizēta</rdfs:label>
    <rdfs:label xml:lang="pt">Vacina trivalente inativada contra influenza, não especificada</rdfs:label>
    <rdfs:label xml:lang="de">Trivalenter inaktivierter Grippeimpfstoff, nicht näher bezeichnet</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
