    <rdfs:label xml:lang="pt">DTaP - Diphtheria-Tetanus-Pertussis vaccine, standard dose, unspecified</rdfs:label>
    <rdfs:label xml:lang="pl">DTaP - Diphtheria-Tetanus-Pertussis vaccine, standard dose, unspecified</rdfs:label>
    <rdfs:label xml:lang="lv">DTaP - Diphtheria-Tetanus-Pertussis vaccine, standard dose, unspecified</rdfs:label>
    <rdfs:label xml:lang="gr">DTaP - Diphtheria-Tetanus-Pertussis vaccine, standard dose, unspecified</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
