    <rdfs:label xml:lang="pl">Trójwalentna żywa atenuowana wartość przeciwko grypie, normalna dawka</rdfs:label>
    <rdfs:label xml:lang="en">Influenza valence, trivalent, live attenuated, standard dose</rdfs:label>
