    <rdfs:label xml:lang="lv">Typhoid-Paratyphoid vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="gr">Typhoid-Paratyphoid vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="fr">Vaccin Typhoïde et Paratyphoïde, sans précision</rdfs:label>
