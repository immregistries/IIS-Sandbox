    <rdfs:comment xml:lang="gr">Εμβόλιο κατά του μηνιγγιτιδόκοκκου C</rdfs:comment>
    <rdfs:comment xml:lang="lv">Meningokoka C konjugētā vakcīna</rdfs:comment>
