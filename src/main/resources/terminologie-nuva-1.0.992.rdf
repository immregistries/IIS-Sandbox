    <skos:altLabel xml:lang="pt">COVID-VVr-S-VSV</skos:altLabel>
    <skos:altLabel xml:lang="pl">COVID-VVr-S-VSV</skos:altLabel>
    <skos:altLabel xml:lang="lv">COVID-VVr-S-VSV</skos:altLabel>
    <skos:altLabel xml:lang="gr">COVID-VVr-S-VSV</skos:altLabel>
