  <rdf:Description rdf:about="#VAL365">
    <rdfs:label xml:lang="gr">Μη ζωντανή βαλεντία της γρίπης που προέρχεται από καλλιέργεια σε αυγά, χωρίς διευκρίνιση</rdfs:label>
    <rdfs:label xml:lang="lv">Nedzīva gripas valence, iegūta no olu kultūras, bez precizējuma</rdfs:label>
    <rdfs:label xml:lang="de">Nicht-lebende Influenza-Valenz aus Eikultur, ohne Spezifikation</rdfs:label>
    <rdfs:label xml:lang="pl">Nieżywa wartość przeciwko grypie uzyskana z hodowli na jajach, bez określenia</rdfs:label>
    <rdfs:label xml:lang="pt">Valência vacinal não viva da gripe obtida por cultura em ovos, sem especificação</rdfs:label>
    <rdfs:label xml:lang="en">Influenza valence, non-live, obtained from egg culture, unspecified</rdfs:label>
    <rdfs:label xml:lang="fr">Valence grippe, non vivante, obtenue sur culture d'œufs, sans précision</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Valence"/>
    <rdfs:subClassOf rdf:resource="#VAL364"/>
