    <skos:hiddenLabel>typhoparatyphoid</skos:hiddenLabel>
    <skos:hiddenLabel>Typhoparatyphoïdique</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#VAC1352">
    <rdfs:label>TERATECT</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
