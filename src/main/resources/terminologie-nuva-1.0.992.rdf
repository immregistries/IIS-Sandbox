  <rdf:Description rdf:about="#VAC0895">
    <rdfs:label xml:lang="en">Venezuelan Equine Encephalitis Vaccine, Unspecified</rdfs:label>
    <rdfs:label xml:lang="fr">Vaccin Encéphalite équine vénézuélienne, sans précision</rdfs:label>
    <rdfs:label xml:lang="lv">Venecuēlas zirgu encefalīta vakcīna, neprecizēta</rdfs:label>
    <rdfs:label xml:lang="de">Impfstoff gegen Venezolanische Pferdeenzephalitis, nicht spezifiziert</rdfs:label>
    <rdfs:label xml:lang="gr">Εμβόλιο εγκεφαλίτιδας ιπποειδών της Βενεζουέλας, απροσδιόριστο</rdfs:label>
    <rdfs:label xml:lang="pt">Vacina venezuelana contra encefalite equina, não especificada</rdfs:label>
    <rdfs:label xml:lang="pl">Wenezuelska szczepionka przeciwko zapaleniu mózgu koni, nieokreślona</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
