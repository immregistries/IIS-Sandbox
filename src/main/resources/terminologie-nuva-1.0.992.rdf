  <rdf:Description rdf:about="#VAC1080">
    <rdfs:label>COVAXIN</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-05-14</dct:created>
    <rdfs:comment xml:lang="en">COVID-19 vaccine, whole virion inactivated</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin à virion entier et inactivé contre le coronavirus (SRAS-CoV-2)</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-25</dct:modified>
    <skos:notation>VAC1080</skos:notation>
