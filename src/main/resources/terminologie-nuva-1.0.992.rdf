  <rdf:Description rdf:about="#VAC0423">
    <rdfs:label>TWINRIX JUNIOR</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-19</dct:created>
    <rdfs:comment xml:lang="fr">Vaccin combiné contre les hépatites A et B, dose pédiatrique</rdfs:comment>
    <rdfs:comment xml:lang="de">Kombinierter Hepatitis-A- und -B-Impfstoff, pädiatrische Dosis</rdfs:comment>
    <rdfs:comment xml:lang="lv">Kombinētā A un B hepatīta vakcīna, pediatriskā deva</rdfs:comment>
    <rdfs:comment xml:lang="gr">Συνδυασμένο εμβόλιο ηπατίτιδας Α και Β, παιδιατρική δόση</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina combinada contra a hepatite A e B, dose pediátrica</rdfs:comment>
    <rdfs:comment xml:lang="pl">Skojarzona szczepionka przeciwko wirusowemu zapaleniu wątroby typu A i B, dawka pediatryczna</rdfs:comment>
    <rdfs:comment xml:lang="en">Combined hepatitis A and B vaccine, pediatric dose</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-10-31</dct:modified>
    <skos:notation>VAC0423</skos:notation>
