  <rdf:Description rdf:about="#VAC0556">
    <rdfs:label>MENITORIX</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-19</dct:created>
    <rdfs:comment xml:lang="de">Haemophilus influenzae Typ b und Meningokokken-C-Konjugatimpfstoff</rdfs:comment>
    <rdfs:comment xml:lang="gr">Εμβόλιο Haemophilus influenzae τύπου β και συζευγμένο εμβόλιο κατά του μηνιγγιτιδόκοκκου C</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina conjugada Haemophilus influenzae tipo b e meningocócica C</rdfs:comment>
    <rdfs:comment xml:lang="lv">Haemophilus influenzae b tipa un meningokoka C konjugētā vakcīna</rdfs:comment>
    <rdfs:comment xml:lang="pl">Haemophilus influenzae typu b i szczepionka skoniugowana przeciwko meningokokom typu C</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin conjugué anti-Haemophilus influenzae type b (conjugué à l'anatoxine tétanique) et contre les méningocoques du sérogroupe C (conjugué à l'anatoxine tétanique)</rdfs:comment>
    <rdfs:comment xml:lang="en">Haemophilus influenzae type b and meningococcal conjugate vaccine, serogroup C (conjugated to tetanus toxoid)</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-10-31</dct:modified>
    <skos:notation>VAC0556</skos:notation>
    <nuvs:containsValence rdf:resource="#VAL156"/>
