    <rdfs:comment xml:lang="en">Polysaccharide typhoid vaccine (Vi capsular antigen)</rdfs:comment>
    <rdfs:comment xml:lang="de">Polysaccharid-Typhusimpfstoff (Vi-Kapselantigen)</rdfs:comment>
    <rdfs:comment xml:lang="pl">Polisacharydowa szczepionka przeciwko durowi brzusznemu (antygen otoczkowy Vi)</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin typhoïdique polyosidique non conjugué (antigène capsulaire Vi)</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina contra o tifóide polissacarídeo (Vi capsular antigene)</rdfs:comment>
    <rdfs:comment xml:lang="gr">Πολυσακχαριδικό εμβόλιο τυφοειδούς (καψικό αντιγόνο Vi)</rdfs:comment>
    <rdfs:comment xml:lang="lv">Polisaharīdu vakcīna pret vēdertīfu (Vi kapsulārais antigēns)</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-04-03</dct:modified>
    <skos:notation>VAC0041</skos:notation>
    <nuvs:containsValence rdf:resource="#VAL032"/>
    <nuvs:isAbstract rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</nuvs:isAbstract>
