    <rdfs:label xml:lang="pl">Kleszczowe zapalenie mózgu</rdfs:label>
    <rdfs:label xml:lang="de">Frühsommer-Meningoenzephalitis</rdfs:label>
    <rdfs:label xml:lang="gr">Εγκεφαλίτιδα από τσιμπούρια</rdfs:label>
    <rdfs:label xml:lang="pt">Encefalite transmitida por carrapatos</rdfs:label>
