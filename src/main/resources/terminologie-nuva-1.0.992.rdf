  <rdf:Description rdf:about="#VAC0315">
    <rdfs:label>MUMPSVAX</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-19</dct:created>
    <rdfs:comment xml:lang="fr">Vaccin vivant atténué contre les oreillons</rdfs:comment>
    <rdfs:comment xml:lang="en">Live attenuated mumps vaccine</rdfs:comment>
    <rdfs:comment xml:lang="de">Attenuierter Mumps-Lebendimpfstoff</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina viva atenuada contra a papeira</rdfs:comment>
    <rdfs:comment xml:lang="pl">Żywa atenuowana szczepionka przeciwko śwince</rdfs:comment>
    <rdfs:comment xml:lang="gr">Ζωντανό εξασθενημένο εμβόλιο παρωτίτιδας</rdfs:comment>
