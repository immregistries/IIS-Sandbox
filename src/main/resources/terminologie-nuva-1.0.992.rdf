    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-05</dct:created>
    <rdfs:comment xml:lang="fr">Vaccin pneumococcique polyosidique conjugué, 23-valent, sérotypes 1, 2, 3, 4, 5, 6B, 7F, 8, 9N, 9V, 10A, 11A, 12F, 14, 15B, 17F, 18C, 19A, 19F, 20, 22F, 23F et 33F</rdfs:comment>
    <rdfs:comment xml:lang="en">Pneumococcal polysaccharide conjugate vaccine, 23-valent, serotypes 1, 2, 3, 4, 5, 6B, 7F, 8, 9N, 9V, 10A, 11A, 12F, 14, 15B, 17F, 18C, 19A, 19F, 20, 22F, 23F and 33F</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina pneumocócica conjugada 23-valente, serotipos 1, 2, 3, 4, 5, 6B, 7F, 8, 9N, 9V, 10A, 11A, 12F, 14, 15B, 17F, 18C, 19A, 19F, 20, 22F, 23F e 33F</rdfs:comment>
    <rdfs:comment xml:lang="de">Konjugierter Polyosid-Pneumokokken-Impfstoff, 23-valent, Serotypen 1, 2, 3, 4, 5, 6B, 7F, 8, 9N, 9V, 10A, 11A, 12F, 14, 15B, 17F, 18C, 19A, 19F, 20, 22F, 23F und 33F</rdfs:comment>
    <rdfs:comment xml:lang="pl">23-walentna skoniugowana szczepionka przeciw pneumokokom, serotypy 1, 2, 3, 4, 5, 6B, 7F, 8, 9N, 9V, 10A, 11A, 12F, 14, 15B, 17F, 18C, 19A, 19F, 20, 22F, 23F i 33F</rdfs:comment>
    <rdfs:comment xml:lang="gr">23-δύναμο πνευμονιοκοκκικό συζευγμένο εμβόλιο, ορότυποι 1, 2, 3, 4, 5, 6B, 7F, 8, 9N, 9V, 10A, 11A, 12F, 14, 15B, 17F, 18C, 19A, 19F, 20, 22F, 23F και 33F</rdfs:comment>
