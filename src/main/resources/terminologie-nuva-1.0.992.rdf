    <rdfs:label xml:lang="de">Rift-Valley-Fieber</rdfs:label>
    <rdfs:label xml:lang="pl">Gorączka Doliny Rift</rdfs:label>
    <rdfs:label xml:lang="gr">Πυρετός της κοιλάδας Rift</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Disease"/>
