    <rdfs:comment xml:lang="fr">Vaccin pédiatrique diphtérique (anatoxine, dose standard) et coquelucheux (entier inactivé)</rdfs:comment>
    <rdfs:comment xml:lang="en">Paediatric diphtheria vaccine (toxoid, standard dose) and pertussis (whole-cell inactivated)</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-07-30</dct:modified>
    <skos:notation>VAC1465</skos:notation>
