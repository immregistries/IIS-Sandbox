  <rdf:Description rdf:about="#VAC0952">
    <rdfs:label>IMOVAX COLERA</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-25</dct:created>
    <rdfs:comment xml:lang="en">Inactivated whole-cell cholera vaccine for injection</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin cholérique entier inactivé, injectable</rdfs:comment>
    <rdfs:comment xml:lang="de">Inaktivierter Cholera-Ganzzellimpfstoff zur Injektion</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina inactivada contra a cólera de células inteiras para injecção</rdfs:comment>
    <rdfs:comment xml:lang="pl">Inaktywowana, pełnokomórkowa szczepionka przeciwko cholerze do wstrzykiwań</rdfs:comment>
    <rdfs:comment xml:lang="gr">Αδρανοποιημένο ολικό εμβόλιο χολέρας για ένεση</rdfs:comment>
    <rdfs:comment xml:lang="lv">Inaktivēta veselas šūnas holēras vakcīna injekcijām</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-08-19</dct:modified>
    <skos:notation>VAC0952</skos:notation>
