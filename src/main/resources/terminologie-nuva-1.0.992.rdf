    <skos:hiddenLabel>DTHib</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#VAC0400">
    <rdfs:label>TRIACELLUVAX</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
