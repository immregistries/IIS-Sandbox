  <rdf:Description rdf:about="#VAC0887">
    <rdfs:label>POLIORAL</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-04-04</dct:created>
    <rdfs:comment xml:lang="en">Polio vaccine (live attenuated, trivalent) against polioviruses 1, 2 and 3, oral</rdfs:comment>
    <rdfs:comment xml:lang="de">Polio-Impfstoff (abgeschwächter Lebendimpfstoff, trivalent) gegen die Polioviren 1, 2 und 3, oral</rdfs:comment>
    <rdfs:comment xml:lang="lv">Poliomielīta vakcīna (dzīvā novājināta, trivalenta) pret 1., 2. un 3. poliovīrusu, perorāla</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin poliomyélitique (vivant atténué, trivalent) contre les poliovirus 1, 2 et 3, par voie orale</rdfs:comment>
    <rdfs:comment xml:lang="pl">Szczepionka przeciwko polio (żywa, atenuowana, trójwartościowa) przeciwko poliovirusom 1, 2 i 3, doustna</rdfs:comment>
    <rdfs:comment xml:lang="gr">Εμβόλιο πολιομυελίτιδας (ζωντανό εξασθενημένο, τρισθενές) κατά των πολιοϊών 1, 2 και 3, από του στόματος</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina contra a poliomielite (viva atenuada, trivalente) contra poliovírus 1, 2 e 3, oral</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-04-22</dct:modified>
    <skos:notation>VAC0887</skos:notation>
    <nuvs:containsValence rdf:resource="#VAL033"/>
    <nuvs:containsValence rdf:resource="#VAL085"/>
    <nuvs:containsValence rdf:resource="#VAL132"/>
