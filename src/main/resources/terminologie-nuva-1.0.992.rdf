  <rdf:Description rdf:about="#VAC0102">
    <rdfs:label xml:lang="fr">Vaccin Hépatite A inactivé, sans précision</rdfs:label>
    <rdfs:label xml:lang="pt">Vacina inactivada contra a hepatite A, não especificada</rdfs:label>
    <rdfs:label xml:lang="gr">Αδρανοποιημένο εμβόλιο ηπατίτιδας Α, απροσδιόριστο</rdfs:label>
    <rdfs:label xml:lang="en">Inactivated hepatitis A vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="lv">Nespecificēta inaktivēta A hepatīta vakcīna</rdfs:label>
    <rdfs:label xml:lang="pl">Inaktywowana szczepionka przeciw wirusowemu zapaleniu wątroby typu A, nieokreślona</rdfs:label>
    <rdfs:label xml:lang="de">Inaktivierter Hepatitis-A-Impfstoff, nicht näher bezeichnet</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-19</dct:created>
    <rdfs:comment xml:lang="fr">Vaccin entier inactivé contre l'hépatite A</rdfs:comment>
    <rdfs:comment xml:lang="en">Inactivated hepatitis A vaccine, pediatric or adult dose</rdfs:comment>
    <rdfs:comment xml:lang="de">Inaktivierter Hepatitis-A-Impfstoff, pädiatrische Dosis oder Erwachsenendosis</rdfs:comment>
    <rdfs:comment xml:lang="lv">Inaktivēta A hepatīta vakcīna, bērnu vai pieaugušo deva</rdfs:comment>
    <rdfs:comment xml:lang="pl">Inaktywowana szczepionka przeciwko wirusowemu zapaleniu wątroby typu A, dawka pediatryczna lub dla dorosłych</rdfs:comment>
