  <rdf:Description rdf:about="#VAC0092">
    <rdfs:label>VACCIN CHOLERIQUE PASTEUR</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-19</dct:created>
    <rdfs:comment xml:lang="en">Inactivated whole-cell cholera vaccine for injection</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin cholérique entier inactivé, injectable</rdfs:comment>
    <rdfs:comment xml:lang="de">Inaktivierter Cholera-Vollzellimpfstoff zur Injektion</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina inactivada contra a cólera de células inteiras para injecção</rdfs:comment>
    <rdfs:comment xml:lang="pl">Inaktywowana, pełnokomórkowa szczepionka przeciwko cholerze do wstrzykiwań</rdfs:comment>
    <rdfs:comment xml:lang="lv">Inaktivēta pilnšūnu holēras vakcīna injekcijām</rdfs:comment>
    <rdfs:comment xml:lang="gr">Αδρανοποιημένο εμβόλιο χολέρας ολικών κυττάρων για ένεση</rdfs:comment>
