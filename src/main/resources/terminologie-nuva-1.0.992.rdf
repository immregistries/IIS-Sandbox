    <skos:hiddenLabel>vrs</skos:hiddenLabel>
    <skos:hiddenLabel>syncytial</skos:hiddenLabel>
  </rdf:Description>
  <rdf:Description rdf:about="#VAC1265">
    <rdfs:label>CLODIVAC</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-17</dct:created>
    <rdfs:comment xml:lang="fr">Vaccin diphtérique (anatoxine, dose réduite) et tétanique (anatoxine)</rdfs:comment>
    <rdfs:comment xml:lang="en">Diphtheria toxoid (low dose) and tetanus toxoid vaccine</rdfs:comment>
    <rdfs:comment xml:lang="de">Diphtherietoxoid- (niedrige Dosis) und Tetanustoxoid-Impfstoff</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina contra difteria toxoide (dose baixa) e tétano toxoide</rdfs:comment>
    <rdfs:comment xml:lang="pl">Szczepionka zawierająca toksoid błoniczy (mała dawka) i toksoid tężcowy</rdfs:comment>
    <rdfs:comment xml:lang="lv">Difterijas toksoīda (mazā deva) un stingumkrampju toksoīda vakcīna</rdfs:comment>
    <rdfs:comment xml:lang="gr">Εμβόλιο διφθεριδοτοξοειδούς (χαμηλή δόση) και τετανικού τοξοειδούς</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-17</dct:modified>
