  <rdf:Description rdf:about="#VAC0942">
    <rdfs:label xml:lang="fr">Vaccin Rage embryon de poulet, sans précision</rdfs:label>
    <rdfs:label xml:lang="en">Chicken embryo rabies vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="pt">Vacina anti-rábica de embrião de galinha, não especificada</rdfs:label>
    <rdfs:label xml:lang="de">Tollwutimpfstoff gegen Hühnerembryonen, nicht näher bezeichnet</rdfs:label>
