    <rdfs:label>VA-MENGOC-BC</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="#Vaccine"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-07-19</dct:created>
    <rdfs:comment xml:lang="de">Impfstoff gegen Meningokokken der Serogruppe B und C</rdfs:comment>
    <rdfs:comment xml:lang="lv">B un C serogrupas meningokoku vakcīna</rdfs:comment>
    <rdfs:comment xml:lang="pl">Szczepionka przeciwko meningokokom serogrupy B i C</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina Meningocócica de serogrupo B e C</rdfs:comment>
    <rdfs:comment xml:lang="gr">Εμβόλιο κατά του μηνιγγιτιδόκοκκου οροομάδας Β και C</rdfs:comment>
    <rdfs:comment xml:lang="fr">Vaccin contre les méningocoques des sérogroupes B (à protéines de vésicules de membrane externe B:14:P1.7,16) et C</rdfs:comment>
    <rdfs:comment xml:lang="en">Meningococcal vaccine, serogroups B and C</rdfs:comment>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-10-31</dct:modified>
