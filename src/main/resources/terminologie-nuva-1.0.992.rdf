    <rdfs:comment xml:lang="pt">Vacina toxóide do tétano</rdfs:comment>
    <rdfs:comment xml:lang="lv">Stingumkrampju toksoīda vakcīna</rdfs:comment>
    <rdfs:comment xml:lang="pl">Szczepionka zawierająca toksoid tężcowy</rdfs:comment>
    <rdfs:comment xml:lang="gr">Εμβόλιο τοξοειδούς τετάνου</rdfs:comment>
