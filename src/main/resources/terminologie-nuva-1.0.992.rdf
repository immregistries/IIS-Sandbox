    <skos:altLabel xml:lang="lv">Rab-I-Fuenzalida</skos:altLabel>
    <skos:altLabel xml:lang="gr">Rab-I-Fuenzalida</skos:altLabel>
    <nuvs:containedInVaccine rdf:resource="#VAC0903"/>
    <nuvs:prevents rdf:resource="#D30"/>
  </rdf:Description>
