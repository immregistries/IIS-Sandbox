  <rdf:Description rdf:about="#VAC0997">
    <rdfs:label xml:lang="en">Pneumococcal 13-valent conjugate vaccine, unspecified</rdfs:label>
    <rdfs:label xml:lang="fr">Vaccin Pneumocoque conjugué 13-valent, sans précision</rdfs:label>
    <rdfs:label xml:lang="pl">13-walentna szczepionka skoniugowana przeciwko pneumokokom, nieokreślona</rdfs:label>
