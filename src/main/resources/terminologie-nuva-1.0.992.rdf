    <rdfs:comment xml:lang="en">Influenza A(H5N1) vaccine</rdfs:comment>
    <rdfs:comment xml:lang="de">Impfstoff gegen Influenza A(H5N1)</rdfs:comment>
    <rdfs:comment xml:lang="lv">A(H5N1) gripas vakcīna</rdfs:comment>
    <rdfs:comment xml:lang="pt">Vacina contra a Influenza A(H5N1)</rdfs:comment>
    <rdfs:comment xml:lang="pl">Szczepionka przeciwko grypie A(H5N1)</rdfs:comment>
    <rdfs:comment xml:lang="gr">Εμβόλιο κατά της γρίπης Α(Η5Ν1)</rdfs:comment>
