<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="org.immregistries.iis.kernal.model.persisted">
    <class name="IisKey" table="IIS_KEY">
        <id name="id" column="DB_ID">
            <generator class="native"/>
        </id>
        <property name="keyString" type="string" column="KEY_STRING"/>
        <property name="keyId" type="string" column="KEY_ID"/>

        <many-to-one name="userAccess" class="UserAccess" column="USER_ACCESS_ID"/>
    </class>
</hibernate-mapping>