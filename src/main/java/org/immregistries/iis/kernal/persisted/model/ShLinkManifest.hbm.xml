<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="org.immregistries.iis.kernal.model.persisted">
    <class name="ShLinkManifest" table="SH_LINK_MANIFEST">
        <id name="id" type="string" column="MANIFEST_ID">
            <generator class="assigned"/>
        </id>
        <property name="status" type="string" column="STATUS"/>
        <many-to-one name="tenant" column="org_id" class="Tenant"/>


        <list name="files" table="SH_LINK_MANIFEST_FILES" cascade="all">
            <key column="SH_LINK_MANIFEST_ID"/>
            <index column="FILE_INDEX"/>
            <composite-element class="ShLinkManifest$FileManifest">
                <property name="contentType" type="string" column="CONTENT_TYPE"/>
                <property name="location" type="string" column="LOCATION"/>
                <property name="embedded" column="EMBEDDED" type="text" length="131063"/>
                <!--                TODO optimize Storage ?-->
                <property name="lastUpdated" type="timestamp" column="LAST_UPDATED"/>
            </composite-element>
        </list>
    </class>
</hibernate-mapping>